[Unit]
Description=Proxmox VE web UI kiosk on the local console (cage + Chromium, tty1)
Documentation=file:///usr/local/share/doc/pve-kiosk/README.md
After=systemd-user-sessions.service plymouth-quit-wait.service pveproxy.service
Wants=pveproxy.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=pvekiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
RuntimeDirectory=pve-kiosk
Environment=XDG_SESSION_TYPE=wayland
# Start even when no keyboard or mouse is plugged in yet.
Environment=WLR_LIBINPUT_NO_DEVICES=1
# "+" runs prestart as root: it reads /etc/pve, which the kiosk user cannot.
ExecStartPre=+/usr/local/lib/pve-kiosk/prestart
ExecStart=/usr/local/lib/pve-kiosk/launch
Restart=always
RestartSec=3
# cage does not always exit promptly on SIGTERM.
TimeoutStopSec=12

[Install]
WantedBy=multi-user.target graphical.target
